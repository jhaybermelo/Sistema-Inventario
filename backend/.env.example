DB_USER=postgres
DB_PASSWORD=postgres
# En Docker el host es postgres-db; usa localhost si corres uvicorn fuera de Docker
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres-db:5432/facturacion
SECRET_KEY=change-this-to-a-very-long-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=8
UPLOAD_DIR=uploads
CORS_ORIGINS=["http://localhost:5173","http://localhost","http://localhost:3000"]
